# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Set this to your deployed Render backend URL in production, e.g. https://machine-failure-diagnosis-backend.onrender.com
# In local development, leave empty to use the Vite local proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=

# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
# SQLite database path (use persistent disk mount on Render: sqlite:///./data/machine_diagnosis.db)
DATABASE_URL=sqlite:///./machine_diagnosis.db

# Production frontend domain for CORS
FRONTEND_URL=https://machine-failure-diagnosis-system.vercel.app

# Environment Mode (development | production)
ENVIRONMENT=production
